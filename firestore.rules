rules_version = '2';

// Regras de segurança do Firestore para o Calis Timer.
// Cada usuário só pode ler/escrever o SEU próprio documento em users/{uid}.
// Cole isto em: Firestore Database -> aba "Regras" (Rules) -> Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
